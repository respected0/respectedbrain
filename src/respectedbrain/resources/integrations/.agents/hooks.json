{
  "respected-brain": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider antigravity --event start",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider antigravity --event turn",
        "timeout": 10
      }
    ]
  }
}
