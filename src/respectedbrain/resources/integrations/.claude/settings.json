{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider claude --event start",
            "timeout": 15,
            "statusMessage": "Loading claude second-brain memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider claude --event prompt",
            "timeout": 5,
            "statusMessage": "Loading claude second-brain memory"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider claude --event end",
            "timeout": 3,
            "statusMessage": "Loading claude second-brain memory"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider claude --event precompact",
            "timeout": 10,
            "statusMessage": "Loading claude second-brain memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider claude --event turn",
            "timeout": 10,
            "statusMessage": "Loading claude second-brain memory",
            "async": true
          }
        ]
      }
    ]
  }
}
