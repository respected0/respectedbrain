{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider codex --event start",
            "timeout": 15,
            "statusMessage": "Loading codex second-brain memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider codex --event prompt",
            "timeout": 5,
            "statusMessage": "Loading codex second-brain memory"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider codex --event end",
            "timeout": 3,
            "statusMessage": "Loading codex second-brain memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider codex --event turn",
            "timeout": 10,
            "statusMessage": "Loading codex second-brain memory"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider codex --event precompact",
            "timeout": 10,
            "statusMessage": "Loading codex second-brain memory"
          }
        ]
      }
    ]
  }
}
