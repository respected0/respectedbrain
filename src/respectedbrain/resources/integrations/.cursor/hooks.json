{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider cursor --event start",
        "timeout": 15
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider cursor --event prompt",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider cursor --event end",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider cursor --event precompact",
        "timeout": 10
      }
    ],
    "afterAgentResponse": [
      {
        "command": "respectedbrain hook --vault-id {{VAULT_ID}} --provider cursor --event turn",
        "timeout": 10
      }
    ]
  }
}
