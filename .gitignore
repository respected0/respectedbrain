# ==============================================================================
# Zero-Trust Git Hygiene & Secret Exclusion
# ==============================================================================

# Secrets, Credentials & Tokens
.env
.env.*
*.env
.env.local
.env.development
.env.test
.env.production
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*id_rsa*
*id_ed25519*
*credentials*.json
*token*.json
auth.json
.claude/settings.local.json
*settings.local.json

# Databases, Local Stores & Backups
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak
*.orig
*.yedek
*.yedek-*
*.tmp
tmp/
tmp-brief/
.beyin/backups/
.beyin/cache/
.respected-install-*/

# Local Agent & Runtime State
.beyin/engine/.state/
.claude/hooks/.state/
.claude/scripts/.state/*
!.claude/scripts/.state/.gitkeep
🔮 850-Companion/Session-Logs/

# Python & Testing Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Virtual Environments & Packaging
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/
*.egg
node_modules/

# Operating System Garbage
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
# Linux
*~
.fuse_hidden*

# Editor & IDE Configuration
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.vscode/*.local.json
.obsidian/workspace*
.obsidian/cache

# Diagnostics & Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
