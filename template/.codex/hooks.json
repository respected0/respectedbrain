{
  "description": "Respot Brain çoklu-AI hafıza kancaları (üretilmiştir).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .beyin/hooks/bridge.py --provider codex --event start",
            "commandWindows": "wsl.exe --cd . python3 .beyin/hooks/bridge.py --provider codex --event start",
            "timeout": 15,
            "additionalContextLimit": 16000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .beyin/hooks/bridge.py --provider codex --event prompt",
            "commandWindows": "wsl.exe --cd . python3 .beyin/hooks/bridge.py --provider codex --event prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .beyin/hooks/bridge.py --provider codex --event end",
            "commandWindows": "wsl.exe --cd . python3 .beyin/hooks/bridge.py --provider codex --event end",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .beyin/hooks/bridge.py --provider codex --event precompact",
            "commandWindows": "wsl.exe --cd . python3 .beyin/hooks/bridge.py --provider codex --event precompact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
