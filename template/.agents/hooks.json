{
  "respot-brain": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 .beyin/hooks/bridge.py --provider antigravity --event start",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 .beyin/hooks/bridge.py --provider antigravity --event end",
        "timeout": 10
      }
    ]
  }
}
