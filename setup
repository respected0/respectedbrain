#!/usr/bin/env bash
# ==============================================================================
# Respected Brain v0.0.1 — Linux & Unix Tek Tık Kurulum, Bakım & Yönetim Başlatıcı
# Çift tıklandığında veya ./setup yazıldığında çalışır.
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "${SCRIPT_DIR}"

# 1. Python 3 Kontrolü
PYTHON_BIN=""
if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
fi

if [ -z "${PYTHON_BIN}" ]; then
    echo -e "\033[93m[!] Sisteminizde Python 3 bulunamadı.\033[0m"
    read -r -p "Paket yöneticiniz ile Python 3 kurulsun mu? [E/h]: " USER_RESP
    case "${USER_RESP:-E}" in
        [eE]|[eE][vV][eE][tT]|[yY]|[yY][eE][sS]|"")
            if command -v apt-get >/dev/null 2>&1; then
                sudo apt-get update && sudo apt-get install -y python3 python3-pip
            elif command -v dnf >/dev/null 2>&1; then
                sudo dnf install -y python3
            elif command -v pacman >/dev/null 2>&1; then
                sudo pacman -Sy --noconfirm python
            fi
            PYTHON_BIN="python3"
            ;;
        *)
            echo -e "\033[91mPython 3 olmadan kuruluma devam edilemez.\033[0m"
            exit 1
            ;;
    esac
fi

# 2. Evrensel setup.py motorunu çalıştır
exec "${PYTHON_BIN}" "${SCRIPT_DIR}/setup.py" "$@"
